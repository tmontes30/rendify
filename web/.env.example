# Copia este archivo a .env.local y completa con los datos de tu app web de Firebase
# (Firebase Console > Configuración del proyecto > Tus apps > App web).
# Estos valores NO son secretos: la seguridad la dan las reglas de Firestore.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Opcional (recomendado): App Check con reCAPTCHA v3
VITE_RECAPTCHA_SITE_KEY=
