rules_version = '2';

// Reglas de seguridad para la web pública (usuarios de las empresas).
// La app local del owner usa el Admin SDK y NO pasa por estas reglas.
// Principio: todo lo que no esté explícitamente permitido está denegado.
//
// Estructura:
//   users/{uid}                              perfil (lo escriben el owner y el administrador de personal)
//   companies/{cid}                          empresa
//   companies/{cid}/areas|categories|flows   catálogos de la empresa
//   companies/{cid}/reports/{rid}/items/{iid}

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function uid() {
      return request.auth.uid;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function profile() {
      return get(profilePath()).data;
    }

    // Miembro activo de la empresa según su perfil users/{uid} (fuente de verdad; lo escriben
    // solo el owner o el administrador de personal de esa empresa). Deshabilitar o mover de
    // empresa corta el acceso de inmediato. No se usan claims porque las cuentas creadas por el
    // administrador de personal desde la web no los tienen.
    function belongsTo(cid) {
      return request.auth != null
        && exists(profilePath())
        && profile().active == true
        && profile().companyId == cid;
    }

    // Miembro con servicio vigente: si el owner suspende la empresa (active == false),
    // sus usuarios no pueden leer ni escribir nada (solo ver que está suspendida).
    function member(cid) {
      return belongsTo(cid)
        && get(/databases/$(database)/documents/companies/$(cid)).data.active == true;
    }

    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function isDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // Debe coincidir con CURRENCY_CODES en shared/src/index.ts
    function currencies() {
      return ['CLP', 'USD', 'EUR', 'ARS', 'PEN', 'BRL', 'MXN', 'COP'];
    }

    // Administrador de personal de la empresa (casilla que marca el owner).
    function companyAdmin(cid) {
      return member(cid) && profile().companyAdmin == true;
    }

    function userFields(d) {
      return str(d.displayName, 1, 100)
        && d.displayName.trim() == d.displayName
        && str(d.areaId, 1, 64)
        && (d.flowId == null || str(d.flowId, 1, 64))
        && d.isApprover is bool
        && d.paymentsUser is bool
        && d.active is bool;
    }

    // ---------- Perfiles ----------
    match /users/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || companyAdmin(resource.data.companyId));

      // El administrador de personal crea perfiles en SU empresa (nunca otros administradores).
      allow create: if companyAdmin(request.resource.data.companyId)
        && request.resource.data.keys().hasOnly([
             'email', 'displayName', 'companyId', 'areaId', 'flowId', 'isApprover',
             'paymentsUser', 'active', 'createdAt', 'createdBy'])
        && request.resource.data.keys().hasAll([
             'email', 'displayName', 'companyId', 'areaId', 'flowId', 'isApprover',
             'paymentsUser', 'active', 'createdAt', 'createdBy'])
        && str(request.resource.data.email, 3, 200)
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && userFields(request.resource.data);

      // El administrador de personal edita personas de SU empresa (sin moverlas de empresa
      // ni cambiar quién es administrador).
      allow update: if resource.data.companyId is string
        && companyAdmin(resource.data.companyId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'displayName', 'areaId', 'flowId', 'isApprover', 'paymentsUser', 'active'])
        && userFields(request.resource.data);

      // Cada usuario activo puede cambiar solo su propio nombre. Empresa, área,
      // flujo, estado y rol de aprobador los define únicamente el owner.
      allow update: if request.auth != null
        && request.auth.uid == userId
        && resource.data.active == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && str(request.resource.data.displayName, 1, 100)
        && request.resource.data.displayName.trim() == request.resource.data.displayName;
      allow delete: if false;
    }

    // ---------- Empresa ----------
    match /companies/{cid} {
      // Se puede leer aunque esté suspendida, para mostrar el aviso al usuario.
      allow read: if belongsTo(cid);
      allow write: if false;

      function flowDoc(fid) {
        return get(/databases/$(database)/documents/companies/$(cid)/flows/$(fid)).data;
      }

      match /areas/{id} {
        allow read: if member(cid);
        allow write: if false;
      }

      match /categories/{id} {
        allow read: if member(cid);
        allow write: if false;
      }

      match /flows/{id} {
        allow read: if member(cid);

        // El administrador de personal crea y edita los flujos de su empresa.
        // Quien paga debe ser un usuario de pagos de la misma empresa.
        function validFlow(d) {
          return d.keys().hasOnly(['name', 'levels', 'payerUid', 'allApprovers', 'approverNames', 'updatedAt', 'updatedBy'])
            && str(d.name, 1, 100)
            && d.levels is list && d.levels.size() >= 1 && d.levels.size() <= 8
            && d.levels[0].approvers is list && d.levels[0].approvers.size() >= 1
            && d.allApprovers is list && d.allApprovers.size() <= 200
            && d.approverNames is map
            && d.updatedAt == request.time
            && d.updatedBy == request.auth.uid
            && (d.payerUid == null
                || (exists(/databases/$(database)/documents/users/$(d.payerUid))
                    && get(/databases/$(database)/documents/users/$(d.payerUid)).data.companyId == cid
                    && get(/databases/$(database)/documents/users/$(d.payerUid)).data.paymentsUser == true));
        }

        allow create, update: if companyAdmin(cid) && validFlow(request.resource.data);
        allow delete: if companyAdmin(cid);
      }

      // ---------- Rendiciones ----------
      match /reports/{rid} {

        function reportFields(d) {
          return str(d.title, 1, 120)
            && isDate(d.periodFrom)
            && isDate(d.periodTo)
            && d.periodFrom <= d.periodTo
            && d.totals is map
            && d.totals.keys().hasOnly(currencies())
            && d.itemCount is int
            && d.itemCount >= 0
            && d.itemCount <= 200;
        }

        function inLevel(levels, i) {
          return levels.size() > i && uid() in levels[i].approvers;
        }

        // Nivel de partida: 0, o el siguiente al nivel más alto donde quien envía
        // es aprobador (nadie aprueba lo propio). Máximo 8 niveles.
        function expectedStart(levels) {
          return inLevel(levels, 7) ? 8 : inLevel(levels, 6) ? 7 : inLevel(levels, 5) ? 6
            : inLevel(levels, 4) ? 5 : inLevel(levels, 3) ? 4 : inLevel(levels, 2) ? 3
            : inLevel(levels, 1) ? 2 : inLevel(levels, 0) ? 1 : 0;
        }

        // Al enviar: el flujo debe ser el asignado al usuario, la rendición parte en
        // el nivel que corresponde y los aprobadores son exactamente los de ese nivel.
        // Si quien envía está en el último nivel, queda sin aprobadores (la aprueba el owner).
        function validSubmission(d) {
          return d.flowId is string
            && d.flowId == profile().flowId
            && flowDoc(d.flowId).levels.size() > 0
            && d.currentLevel == expectedStart(flowDoc(d.flowId).levels)
            && ((d.currentLevel < flowDoc(d.flowId).levels.size()
                 && d.currentApprovers == flowDoc(d.flowId).levels[d.currentLevel].approvers)
                || (d.currentLevel == flowDoc(d.flowId).levels.size()
                 && d.currentApprovers.size() == 0))
            && d.approverUids == flowDoc(d.flowId).allApprovers
            && d.itemCount > 0
            && d.submittedAt == request.time;
        }

        function emptyFlowState(d) {
          return d.currentLevel == 0 && d.currentApprovers.size() == 0 && d.approverUids.size() == 0;
        }

        allow read: if member(cid)
          && (resource.data.ownerUid == uid()
              || uid() in resource.data.approverUids
              || uid() in resource.data.currentApprovers
              || profile().companyAdmin == true);

        // Administrador de personal: al cambiar quién paga en un flujo, actualiza quién puede
        // ver las rendiciones ya enviadas (solo personas que participan en ese flujo).
        allow update: if companyAdmin(cid)
          && resource.data.status != 'draft'
          && resource.data.flowId is string
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approverUids'])
          && request.resource.data.approverUids is list
          && request.resource.data.approverUids.hasOnly(
               resource.data.approverUids.concat(flowDoc(resource.data.flowId).allApprovers));

        allow create: if member(cid)
          && request.resource.data.keys().hasOnly([
               'ownerUid', 'ownerName', 'areaId', 'flowId', 'title', 'periodFrom', 'periodTo',
               'status', 'totals', 'itemCount', 'currentLevel', 'currentApprovers',
               'approverUids', 'approvals', 'createdAt', 'updatedAt', 'submittedAt'])
          && request.resource.data.ownerUid == uid()
          && request.resource.data.ownerName == profile().displayName
          && request.resource.data.areaId == profile().areaId
          && request.resource.data.approvals.size() == 0
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && reportFields(request.resource.data)
          && ((request.resource.data.status == 'draft' && emptyFlowState(request.resource.data))
              || (request.resource.data.status == 'pending' && validSubmission(request.resource.data)));

        // Dueño: edita su borrador/rechazada sin enviarla.
        allow update: if member(cid)
          && resource.data.ownerUid == uid()
          && resource.data.status in ['draft', 'rejected']
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'title', 'periodFrom', 'periodTo', 'totals', 'itemCount', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && reportFields(request.resource.data);

        // Dueño: envía (o reenvía) a aprobación.
        allow update: if member(cid)
          && resource.data.ownerUid == uid()
          && resource.data.status in ['draft', 'rejected']
          && request.resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'title', 'periodFrom', 'periodTo', 'totals', 'itemCount', 'updatedAt',
               'status', 'flowId', 'currentLevel', 'currentApprovers', 'approverUids', 'submittedAt'])
          && request.resource.data.updatedAt == request.time
          && reportFields(request.resource.data)
          && validSubmission(request.resource.data);

        // Aprobador del nivel actual: aprueba (avanza o termina) o rechaza.
        function lastApproval(before, after) {
          return after.approvals[before.approvals.size()];
        }

        function validApprovalEntry(before, after) {
          let a = lastApproval(before, after);
          return after.approvals.size() == before.approvals.size() + 1
            // (slice vacío [0:0] da error en las reglas, por eso el caso 0 va aparte)
            && (before.approvals.size() == 0
                || after.approvals[0:before.approvals.size()] == before.approvals)
            && a.keys().hasOnly(['level', 'levelName', 'uid', 'name', 'decision', 'comment', 'atMs'])
            && a.keys().hasAll(['level', 'levelName', 'uid', 'name', 'decision', 'comment', 'atMs'])
            && a.uid == uid()
            && a.name == profile().displayName
            && a.level == before.currentLevel
            && str(a.levelName, 1, 100)
            && str(a.comment, 0, 500)
            && a.atMs is int
            && a.decision in ['approved', 'rejected'];
        }

        allow update: if member(cid)
          && resource.data.status == 'pending'
          && uid() in resource.data.currentApprovers
          && resource.data.ownerUid != uid()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'status', 'currentLevel', 'currentApprovers', 'approvals', 'updatedAt', 'decidedAt'])
          && request.resource.data.updatedAt == request.time
          && request.resource.data.decidedAt == request.time
          && validApprovalEntry(resource.data, request.resource.data)
          && (
            // Aprueba y pasa a un nivel posterior del mismo flujo
            (request.resource.data.status == 'pending'
              && lastApproval(resource.data, request.resource.data).decision == 'approved'
              && request.resource.data.currentLevel > resource.data.currentLevel
              && request.resource.data.currentLevel < flowDoc(resource.data.flowId).levels.size()
              && request.resource.data.currentApprovers
                   == flowDoc(resource.data.flowId).levels[request.resource.data.currentLevel].approvers)
            // Aprueba y la rendición queda aprobada
            || (request.resource.data.status == 'approved'
              && lastApproval(resource.data, request.resource.data).decision == 'approved'
              && request.resource.data.currentApprovers.size() == 0)
            // Rechaza con comentario
            || (request.resource.data.status == 'rejected'
              && lastApproval(resource.data, request.resource.data).decision == 'rejected'
              && lastApproval(resource.data, request.resource.data).comment.size() > 0
              && request.resource.data.currentApprovers.size() == 0)
          );

        // Usuario de pagos asignado al flujo: registra el pago de una rendición
        // aprobada por completo (no la propia). Solo cambia estado y datos del pago.
        allow update: if member(cid)
          && profile().paymentsUser == true
          && resource.data.status == 'approved'
          && resource.data.ownerUid != uid()
          && resource.data.flowId is string
          && flowDoc(resource.data.flowId).payerUid == uid()
          && request.resource.data.status == 'paid'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paidAt', 'updatedAt', 'payment'])
          && request.resource.data.paidAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.payment is map
          && request.resource.data.payment.keys().hasOnly(['uid', 'name', 'method', 'reference', 'paidOn', 'comment'])
          && request.resource.data.payment.keys().hasAll(['uid', 'name', 'method', 'reference', 'paidOn', 'comment'])
          && request.resource.data.payment.uid == uid()
          && request.resource.data.payment.name == profile().displayName
          && request.resource.data.payment.method in ['transferencia', 'efectivo', 'cheque', 'otro']
          && str(request.resource.data.payment.reference, 0, 80)
          && isDate(request.resource.data.payment.paidOn)
          && str(request.resource.data.payment.comment, 0, 500);

        allow delete: if member(cid)
          && resource.data.ownerUid == uid()
          && resource.data.status == 'draft';

        // ---------- Gastos ----------
        match /items/{iid} {
          function reportPath() {
            return /databases/$(database)/documents/companies/$(cid)/reports/$(rid);
          }

          // Se permite escribir si la rendición es propia y estaba editable
          // (o se está creando en el mismo lote).
          function editableByMe() {
            return member(cid)
              && getAfter(reportPath()).data.ownerUid == uid()
              && (!exists(reportPath()) || get(reportPath()).data.status in ['draft', 'rejected']);
          }

          function validItem(d) {
            return d.keys().hasOnly([
                     'date', 'categoryId', 'description', 'vendor', 'docType',
                     'docNumber', 'amount', 'currency'])
              && d.keys().hasAll([
                     'date', 'categoryId', 'description', 'vendor', 'docType',
                     'docNumber', 'amount', 'currency'])
              && isDate(d.date)
              && str(d.categoryId, 1, 64)
              && str(d.description, 1, 500)
              && str(d.vendor, 0, 120)
              && d.docType in ['boleta', 'factura', 'otro']
              && str(d.docNumber, 0, 40)
              && d.amount is int
              && d.amount > 0
              && d.amount <= 1000000000000
              && d.currency in currencies();
          }

          allow read: if member(cid)
            && (get(reportPath()).data.ownerUid == uid()
                || uid() in get(reportPath()).data.approverUids
                || uid() in get(reportPath()).data.currentApprovers
                || profile().companyAdmin == true);

          allow create, update: if editableByMe() && validItem(request.resource.data);

          allow delete: if member(cid)
            && get(reportPath()).data.ownerUid == uid()
            && get(reportPath()).data.status in ['draft', 'rejected'];
        }
      }
    }

    // Cualquier otra ruta: denegada.
  }
}
